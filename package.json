{
  "name": "glean-cookbook",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable recipes for building on the Glean platform.",
  "type": "module",
  "scripts": {
    "build": "npm run build:registry && npm run build:artifacts && npm run build:plugin",
    "build:artifacts": "node scripts/build-artifacts.mjs",
    "build:registry": "node scripts/build-registry.mjs",
    "build:plugin": "npm --prefix plugin run build",
    "sync:tokens": "node scripts/sync-brand-tokens.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "verify:recipe": "node scripts/verify-recipe.mjs",
    "check:freshness": "node scripts/check-recipe-freshness.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "release": "release-it",
    "snippets:check": "md-code check && node scripts/check-prompt-snippets.mjs",
    "skill-context:check": "node scripts/check-skill-context.mjs",
    "install-scripts:check": "node scripts/check-install-scripts.mjs",
    "recipe-commands:check": "node scripts/check-recipe-commands.mjs",
    "recipe-packages:check": "node scripts/check-recipe-packages.mjs",
    "snippets:sync": "md-code sync",
    "test": "node --test \"scripts/**/*.test.mjs\" && npm run recipe-packages:check && npm run artifacts:check && npm run execution:check",
    "verify:login": "node scripts/verify-login.mjs",
    "artifacts:check": "node scripts/build-artifacts.mjs --check",
    "execution:check": "node scripts/check-recipe-execution.mjs",
    "recipe-questions:check": "node scripts/check-recipe-questions.mjs",
    "mdx:check": "node scripts/check-recipe-mdx.mjs"
  },
  "devDependencies": {
    "@release-it/bumper": "^8.0.0",
    "@release-it/conventional-changelog": "^12.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.0",
    "markdown-code": "^1.2.0",
    "postcss": "^8.5.26",
    "prettier": "^3.4.2",
    "release-it": "^21.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
