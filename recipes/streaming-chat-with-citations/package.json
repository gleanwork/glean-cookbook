{
  "name": "streaming-chat-with-citations",
  "version": "0.0.0",
  "private": true,
  "description": "Use the modern Glean Platform Chat API with OAuth, conversation state, citations, and createStream EventStream iteration.",
  "type": "module",
  "scripts": {
    "login": "glean-auth login --scopes chat",
    "start": "tsx src/main.ts",
    "verify": "tsx src/main.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:all": "npm run test && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@gleanwork/api-client": "0.20.2",
    "@gleanwork/auth": "0.5.1",
    "meow": "14.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "10.8.0",
    "msw": "2.11.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false,
    "msw@2.11.3": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
