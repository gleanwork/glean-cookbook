{
  "name": "import-plugin-skills",
  "version": "0.0.0",
  "private": true,
  "description": "Sign in to Glean in a local web UI, then publish every skill in an agent plugin through the Skills API.",
  "type": "module",
  "scripts": {
    "login": "glean-auth login --scopes SKILLS",
    "start": "tsx server.ts",
    "test": "vitest run",
    "lint": "eslint src server.ts",
    "typecheck": "tsc --noEmit",
    "test:all": "npm run test && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@gleanwork/api-client": "0.20.16",
    "@gleanwork/auth": "1.0.0",
    "fflate": "0.8.3",
    "open": "11.0.4",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/yauzl": "3.4.0",
    "eslint": "10.10.0",
    "msw": "2.11.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false,
    "msw@2.11.3": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
