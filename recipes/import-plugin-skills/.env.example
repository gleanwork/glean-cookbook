# OAuth: Sign in with Glean (or npm run login) stores tokens outside this directory
# and does not write .env.
# Token fallback: copy this file to .env, or export the same keys in the shell.
# npm start loads .env if present. Existing shell variables win.

# Reader fills this when not passing --backend or --email. Sign-in does not write it here.
GLEAN_SERVER_URL=

# Reader fills this only when OAuth is not available. Sign-in does not write it here.
GLEAN_API_TOKEN=
