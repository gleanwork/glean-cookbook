# OAuth: npm run login stores tokens outside this directory and does not write .env.
# Token fallback: copy this file to .env, or export the same keys in the shell.
# npm start and npm run verify load .env if present. Existing shell variables win.

# Reader fills this when not using --email. Login discovery does not write it here.
GLEAN_SERVER_URL=

# Reader fills this only when OAuth is not available. Login does not write it here.
GLEAN_API_TOKEN=

# Optional. native (default) or legacy. Overrides .glean-scope-mode from npm run login.
GLEAN_SKILLS_SCOPE_MODE=
