{
  "name": "retrieve-document-by-url",
  "version": "0.0.0",
  "private": true,
  "description": "Retrieve one indexed document you can open by URL, then again by the document ID that response prints.",
  "type": "module",
  "scripts": {
    "login": "glean-auth login --scopes documents:read",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test:all": "npm run test && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@gleanwork/auth": "1.0.0",
    "meow": "14.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "10.10.0",
    "msw": "2.11.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false,
    "msw@2.11.3": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
