# OAuth: npm run login stores tokens outside this directory and does not write .env.
# Token fallback: copy this file to .env, or export the same keys in the shell.
# npm start loads .env if present. Existing shell variables win.

# Fill this in when you are not using --email. Login does not write it here.
# Backend origin, for example https://<instance>-be.glean.com
GLEAN_SERVER_URL=

# Fill this in only when you cannot use OAuth. Login does not write it here.
# Create a user-scoped API token and choose documents:read (legacy label DOCUMENTS).
GLEAN_API_TOKEN=
