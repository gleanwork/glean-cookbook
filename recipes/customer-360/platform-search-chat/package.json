{
  "name": "customer-360-platform-search-chat",
  "version": "0.0.0",
  "private": true,
  "description": "Customer 360 — Platform Search tiles + Client Chat synthesis.",
  "type": "module",
  "scripts": {
    "login": "node scripts/glean-auth.mjs login --scopes search,chat --require GLEAN_ACCOUNT_NAME",
    "demo": "node --import tsx scripts/demo.mjs",
    "start": "tsx server.ts",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "verify": "node scripts/verify.mjs",
    "verify:fixture": "npm test && GLEAN_USE_FIXTURE=true GLEAN_ACCOUNT_NAME=Globex node scripts/verify.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@gleanwork/api-client": "0.18.0",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "eslint": "10.8.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
