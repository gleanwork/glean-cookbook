# Required for live mode (ignored when GLEAN_USE_FIXTURE=true)
# Your Glean backend URL, e.g. https://your-instance-be.glean.com — taken directly rather
# than derived from an instance name, since backend naming is not always default.
GLEAN_SERVER_URL=

# The account this page is built around. Pick one your own content covers.
GLEAN_ACCOUNT_NAME=
GLEAN_API_TOKEN=

# Contract-only verification without live Platform handlers
GLEAN_USE_FIXTURE=true

# Platform Search + Chat are experimental — required for live calls
X_GLEAN_INCLUDE_EXPERIMENTAL=true
