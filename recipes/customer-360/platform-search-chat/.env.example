# Copy this file to .env and fill in the blanks.
# Running "npm run login" creates .env for you and fills in the first two.

# Your Glean instance, for example https://acme-be.glean.com
GLEAN_SERVER_URL=

# A Glean API token carrying the SEARCH and CHAT scopes.
GLEAN_API_TOKEN=

# The customer this page is about, for example Acme Logistics. Spell it the way
# your Glean documents spell it. This is not your own company, and it is not
# your Glean instance name.
GLEAN_ACCOUNT_NAME=

# PORT=3000
