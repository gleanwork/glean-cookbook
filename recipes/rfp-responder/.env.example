# Your own Glean instance name (the subdomain, not the full URL).
GLEAN_INSTANCE=

# Your own OAuth access token or Glean API token with the CHAT scope.
# This recipe runs as *you*. There is no impersonation and no act-as: whatever
# you cannot see, the drafts cannot cite. That is the point — see README.
GLEAN_API_TOKEN=

# Set true to run entirely from recorded fixtures (no network, no credentials).
GLEAN_USE_FIXTURE=false

PORT=3000
