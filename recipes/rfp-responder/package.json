{
  "name": "rfp-responder",
  "version": "0.0.0",
  "private": true,
  "description": "RFP & questionnaire responder — grounded, cited draft answers with a human approval gate.",
  "type": "module",
  "scripts": {
    "login": "node scripts/glean-auth.mjs login --scopes chat",
    "demo": "node --import tsx scripts/demo.mjs",
    "start": "GLEAN_USE_FIXTURE=true tsx server.ts",
    "start:live": "GLEAN_USE_FIXTURE=false tsx server.ts",
    "verify": "node scripts/verify.mjs",
    "verify:fixture": "GLEAN_USE_FIXTURE=true node scripts/verify.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsx": "4.23.1",
    "@types/node": "26.1.1",
    "eslint": "10.8.0",
    "typescript-eslint": "8.65.0"
  }
}
