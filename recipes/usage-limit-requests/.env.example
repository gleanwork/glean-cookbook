# Copy this file to .env and fill in both values. npm start and npm run verify
# load .env if it exists; variables already set in the shell win.

# Complete backend origin, shown under Server instance (QE) in the Admin Console.
GLEAN_SERVER_URL=

# User-scoped Client API token from Token Management, created by a user with
# billing permissions, with the ADMIN_USAGE_LIMIT_INCREASE_REQUESTS,
# USAGE_LIMIT_INCREASE_REQUESTS, ADMIN_USAGE, and PEOPLE scopes.
GLEAN_API_TOKEN=
