{
  "name": "company-answers-chat-api",
  "version": "0.0.0",
  "private": true,
  "description": "Company Answers — Platform Chat path: glean.chat.create, you own the UI.",
  "type": "module",
  "scripts": {
    "login": "node scripts/glean-auth.mjs login --scopes chat --require GLEAN_DEMO_QUERY",
    "demo": "node --import tsx scripts/demo.mjs",
    "start": "tsx server.ts",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "verify": "node scripts/verify.mjs",
    "verify:fixture": "npm test && GLEAN_USE_FIXTURE=true node scripts/verify.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@gleanwork/api-client": "0.19.0",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsx": "4.23.1",
    "@types/node": "26.1.1",
    "eslint": "10.8.0",
    "typescript-eslint": "8.65.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  }
}
