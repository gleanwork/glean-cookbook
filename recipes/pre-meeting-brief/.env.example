GLEAN_SERVER_URL=
GLEAN_API_TOKEN=
CURSOR_WEBHOOK_URL=
CURSOR_WEBHOOK_BEARER_TOKEN=

# Required. `npm run preview` lists what your deployment serves. Deliberately
# blank: preset ids differ per deployment, so a default registers the wrong
# events or none.
GLEAN_CALENDAR_PRESET_ID=

# Optional. This recipe demonstrates a 30-minute pre-meeting brief; change
# these to drive the same code from a different preset family or lead time.
#
# Set GLEAN_TRIGGER_OFFSET_SECONDS=none for a preset that is not scheduled at
# all — SLACK_1, JIRA_1, GONG_1 all fire on something that already happened and
# advertise no time_offset, so leaving the requirement on refuses them.
# Whatever the preset does require is read from GLEAN_TRIGGER_INPUT_<FIELD>.
GLEAN_TRIGGER_DATASOURCE=googlecalendar
GLEAN_TRIGGER_OFFSET_SECONDS=1800

# Written by `npm run setup`.
GLEAN_TRIGGER_ID=
GLEAN_WEBHOOK_SIGNING_SECRET=

# The reviewed meeting-title pattern, filtered at the source so Glean stops
# sending events the automation would only discard. Set it to the same pattern
# the automation prompt accepts.
#
# Matching is a case-insensitive substring, not an exact title and not a regex,
# and it matches mid-word: `rigger` matches "Triggers". A short pattern is
# therefore far broader than it looks — use a distinctive phrase.
#
# The field is spelled TITLE in upper case, unlike every other input on this
# preset. That is the preset's own spelling and the variable name follows it. An
# input the preset does not recognise is not an error: the trigger matches
# nothing and never fires, which is indistinguishable from a quiet calendar.
GLEAN_TRIGGER_INPUT_TITLE=

# Optional. Any other input the preset advertises is registered when set, and
# left out when not — `npm run preview` prints what yours takes:
#   GLEAN_TRIGGER_INPUT_ORGANIZER=you@example.com
#   GLEAN_TRIGGER_INPUT_TYPE=meeting
