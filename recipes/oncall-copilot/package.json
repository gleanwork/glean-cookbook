{
  "name": "oncall-copilot",
  "version": "0.0.0",
  "private": true,
  "description": "On-call copilot: evidence-ranked triage, a real approval gate, and pre-registered actions only.",
  "type": "module",
  "scripts": {
    "login": "node scripts/glean-auth.mjs login --scopes search,chat",
    "login:agent": "node scripts/glean-auth.mjs login --scopes search,chat,agents",
    "demo": "node --import tsx scripts/demo.mjs",
    "start": "tsx server.ts",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "verify": "node scripts/verify.mjs",
    "verify:fixture": "npm test && GLEAN_USE_FIXTURE=true node scripts/verify.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsx": "4.23.1",
    "@types/node": "26.1.1",
    "eslint": "10.8.0",
    "typescript-eslint": "8.65.0"
  }
}
