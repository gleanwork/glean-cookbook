# Your Glean backend URL, e.g. https://acme-be.glean.com. Taken directly rather
# than derived from an instance name, which only works for the default naming.
GLEAN_SERVER_URL=

# Your own OAuth access token or Glean API token with SEARCH and CHAT scopes.
# Add AGENTS to run the Glean-agent orchestrator.
GLEAN_API_TOKEN=

# Optional: a Glean agent to drive the agent-orchestrated path. Without it the
# app falls back to app-orchestration and says so in the UI.
GLEAN_AGENT_ID=

# Who the dashboard is signed in as. The approval gate is enforced against the
# service registry, so change this to see a 403.
INCIDENT_ACTOR=marcus.webb@sample.example.com

# How long a proposed action waits before it escalates. The payments-service
# catalog entry specifies 30 minutes; keep it short to watch it happen.
# Overrides the per-service approval window from the service catalog. Unset in
# normal use -- the window belongs to the service, not to this process.
APPROVAL_EXPIRY_MS=

# Enables the demo affordances: the x-incident-actor header (act as anyone, so you
# can watch the gate refuse you) and simulateFailure. Off by default: both let a
# caller bypass the identity the approval gate depends on. Set true only while
# deliberately exercising those demo paths; never enable it in a deployment.
INCIDENT_DEMO_MODE=false

# Set true to run entirely from recorded fixtures (no network, no credentials).
GLEAN_USE_FIXTURE=false

# PORT=3000
