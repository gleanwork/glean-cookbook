# Your Glean backend URL, e.g. https://acme-be.glean.com. Taken directly rather
# than derived from an instance name, which only works for the default naming.
GLEAN_SERVER_URL=

# Your own OAuth access token or Glean API token with SEARCH and CHAT scopes.
# Add AGENTS to run the Glean-agent orchestrator.
GLEAN_API_TOKEN=

# Optional: a Glean agent to drive the agent-orchestrated path. Without it the
# app falls back to app-orchestration and says so in the UI.
GLEAN_AGENT_ID=

# Who the dashboard acts as by default. Fixture mode lets the dashboard assert a
# different actor so you can watch the gate return 403 without restarting.
INCIDENT_ACTOR=marcus.webb@sample.example.com

# The fixture catalog stores names, not identities. This domain turns a name such
# as "Priya Natarajan" into priya.natarajan@sample.example.com. Before live use,
# parse real identities from your catalog instead of relying on this conversion.
APPROVER_EMAIL_DOMAIN=sample.example.com

# How long a proposed action waits before it escalates. The payments-service
# catalog entry specifies 30 minutes; keep it short to watch it happen.
# Overrides the per-service approval window from the service catalog. Unset in
# normal use -- the window belongs to the service, not to this process.
APPROVAL_EXPIRY_MS=

# Enables live-mode demo affordances: the x-incident-actor header and
# simulateFailure. Fixture mode already permits the actor header because it has
# no credentials or real actions. Never enable this in a deployment.
INCIDENT_DEMO_MODE=false

# `npm start` runs recorded fixtures with no credentials or network.
# `npm run start:live` sets this false, but only after you adapt the catalog and
# evidence parsers described in README.md. It is not a generic live demo switch.
GLEAN_USE_FIXTURE=true

# PORT=3000
