# Copy to .env. npm run login stores your OAuth session outside this project;
# it does not write this file.

# The Auto mode agent you saved in Agent Builder (see agent-setup.md).
GLEAN_AGENT_ID=

# A harmless, unique message for the dedicated test channel.
# Change the marker for each new run so you can count posts in Slack.
GLEAN_MESSAGE="Cookbook approval test 001: ready for review."

# Optional. Skip --email discovery by setting your backend origin.
# GLEAN_SERVER_URL=

# Leave empty to use your OAuth session. Set it only when OAuth is unavailable:
# a user-scoped token with agents.run. It is not refreshed, so a run waiting
# for review can outlive it.
GLEAN_API_TOKEN=
