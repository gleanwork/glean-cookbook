# Optional. Copy to .env to avoid repeating flags. npm run login stores your
# OAuth session outside this project; it does not write this file.

# The agent you saved in Agent Builder. --agent-id overrides it.
GLEAN_AGENT_ID=

# Optional. Your Glean backend origin, to skip --email discovery.
# GLEAN_SERVER_URL=

# Leave empty to use your OAuth session. Only for when OAuth is unavailable:
# a user-scoped token with the agents scope. It is not refreshed, so a run
# waiting for review can outlive it.
GLEAN_API_TOKEN=
