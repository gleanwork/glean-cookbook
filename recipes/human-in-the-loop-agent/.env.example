# Login fills these in. Use a per-user credential with agents.run.
# A Glean-issued, user-scoped token is the fallback if OAuth is unavailable.
GLEAN_SERVER_URL=
GLEAN_API_TOKEN=

# The published Auto mode agent you create in agent-setup.md.
GLEAN_AGENT_ID=

# A harmless, unique message for the dedicated test channel.
# Change the marker for each new run so you can count posts in Slack.
GLEAN_MESSAGE="Cookbook approval test 001: ready for review."
