  "What should I do on my first day?": {
    "messages": [
      {
        "author": "GLEAN_AI",
        "messageType": "UPDATE",
        "fragments": [{ "text": "Searching company knowledge" }]
      },
      {
        "author": "GLEAN_AI",
        "messageType": "CONTENT",
        "fragments": [
          {
            "text": "The onboarding checklist lists laptop provisioning, badge access, IT account setup, Slack/email access, and a team introduction as already completed. Still pending: security awareness training (due within two weeks of start), benefits enrollment (deadline 30 days from start), a 1:1 with manager Priya Natarajan, and a payments-service architecture walkthrough."
          },
          {
            "text": "",
            "citation": {
              "sourceDocument": {
                "title": "Onboarding Checklist — Alex Kim",
                "url": "https://portal.sample.internal/hr/onboarding/alex-kim"
              }
            }
          }
        ]
      }
    ]
  },
  "How do I set up VPN?": {
    "messages": [
      {
        "author": "GLEAN_AI",
        "messageType": "UPDATE",
        "fragments": [{ "text": "Searching company knowledge" }]
      },
      {
        "author": "GLEAN_AI",
        "messageType": "CONTENT",
        "fragments": [
          {
            "text": "Install the Sample Corp VPN client from the IT portal's software catalog. Log in with SSO credentials; MFA is required on first connection per device. Split-tunneling is enabled by default, so only internal-network traffic routes through the VPN."
          },
          {
            "text": "",
            "citation": {
              "sourceDocument": {
                "title": "VPN Setup Guide",
                "url": "https://portal.sample.internal/support/vpn-setup"
              }
            }
          }
        ]
      }
    ]
  },
  "What's our PTO policy?": {
    "messages": [
      {
        "author": "GLEAN_AI",
        "messageType": "UPDATE",
        "fragments": [{ "text": "Searching company knowledge" }]
      },
      {
        "author": "GLEAN_AI",
        "messageType": "CONTENT",
        "fragments": [
          {
            "text": "Sample Corp provides flexible PTO with no fixed accrual cap. Take at least 15 days per year and coordinate a week or longer with your manager at least two weeks in advance. Request PTO through the HR portal; unused PTO does not carry over."
          },
          {
            "text": "",
            "citation": {
              "sourceDocument": {
                "title": "Sample Corp PTO Policy",
                "url": "https://portal.sample.internal/hr/pto-policy"
              }
            }
          }
        ]
      }
    ]
  },
