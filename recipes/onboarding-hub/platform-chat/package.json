{
  "name": "onboarding-hub-platform-chat",
  "version": "0.0.0",
  "private": true,
  "description": "Onboarding Hub — Client Chat path with a custom UI.",
  "type": "module",
  "scripts": {
    "login": "node scripts/glean-auth.mjs login --scopes chat --require GLEAN_ONBOARDING_STEPS_FILE",
    "demo": "node --import tsx scripts/demo.mjs",
    "start": "tsx server.ts",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "verify": "node scripts/verify.mjs",
    "verify:fixture": "npm test && GLEAN_USE_FIXTURE=true GLEAN_ONBOARDING_STEPS_FILE=./steps.example.json node scripts/verify.mjs",
    "verify:context": "node scripts/verify-context.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "tsx": "4.23.1",
    "@types/node": "26.1.1",
    "eslint": "10.8.0",
    "typescript-eslint": "8.65.0"
  }
}
