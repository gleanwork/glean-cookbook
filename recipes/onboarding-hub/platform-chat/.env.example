# Copy this file to .env and fill in the blanks.
# Running "npm run login" creates .env for you and fills in GLEAN_SERVER_URL and GLEAN_API_TOKEN.

# Your Glean instance, for example https://acme-be.glean.com
GLEAN_SERVER_URL=

# A Glean API token carrying the CHAT scope.
GLEAN_API_TOKEN=

# Path to a JSON file of onboarding steps. The included example is enough to
# run the app. Edit that file, or point this at one of your own.
GLEAN_ONBOARDING_STEPS_FILE=./steps.example.json
# Alternative: paste the same JSON inline instead of using a file.
# GLEAN_ONBOARDING_STEPS_JSON=[{"id":"vpn","title":"Set up VPN","group":"it","initiallyDone":false,"askPrompt":"How do I set up VPN?"}]

PORT=3000
