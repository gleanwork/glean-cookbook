# Setup-time/deployment configuration only; never collect this from browser users.
# Run npm run configure -- --email "you@company.com" or enter the tenant backend manually.
VITE_GLEAN_BACKEND=
# Setup-time/deployment configuration only; do not derive it from the backend.
# Find the exact value in Glean Admin > About Glean > Web app URL.
VITE_GLEAN_WEB_APP_URL=
# Optional: seed Search and Chat with a topic you know is indexed.
VITE_GLEAN_INITIAL_QUERY=
VITE_GLEAN_INITIAL_MESSAGE=
