# Copy this file to .env and set the agent and backend.
# `npm run login -- --email <work-email>` stores refreshable OAuth
# credentials outside this project.

# Your Glean Platform API backend, for example https://acme-be.glean.com
GLEAN_SERVER_URL=

# Optional user-scoped token fallback. @gleanwork/auth uses it when present.
GLEAN_API_TOKEN=

# A published conversational support-triage Agent. Form-triggered Agents need
# an input object and are intentionally outside this beginner recipe.
GLEAN_AGENT_ID=

# The issue can be supplied as the first argument to npm run triage. This value
# is useful for npm run verify when you want a repeatable live check.
GLEAN_SUPPORT_ISSUE=
