GLEAN_SERVER_URL=
GLEAN_API_TOKEN=
GLEAN_WEBHOOK_URL=

# Which datasource's presets to watch, and which of them to register.
# The receiver, journal, and monitor stream are datasource-agnostic — point
# them at any datasource the Triggers API serves by changing these two lines.
#
# Run `npm run setup` with GLEAN_TRIGGER_PRESET_IDS empty and it prints the
# presets your deployment actually serves, then refuses rather than guessing.
#
# For the pull-request review flow this recipe's skill implements, register the
# review-requested and ready-for-review presets together: a partial set looks
# like it worked and misses the events it did not cover.
#
# The catalog also serves an assigned-to-me preset. It is deliberately left out:
# on GitHub an assignee is not a reviewer, so it fires on pull requests you own
# as well as ones you were asked to review. Add it if you want that too.
GLEAN_TRIGGER_DATASOURCE=github
GLEAN_TRIGGER_PRESET_IDS=

# Presets that require an input read it from GLEAN_TRIGGER_INPUT_<FIELD>, in
# upper case — GLEAN_TRIGGER_INPUT_CHANNEL for a Slack channel preset,
# GLEAN_TRIGGER_INPUT_LABEL for a Jira one. Setup lists what a preset requires
# and refuses before creating anything. The GitHub review presets require none,
# so nothing goes here for the flow this recipe's skill implements.

# Written by `npm run setup`. Signing secrets are returned once, at creation.
GLEAN_TRIGGER_IDS=
GLEAN_WEBHOOK_SECRETS=

GLEAN_REVIEW_STATE_DIR=.data
GLEAN_COOKBOOK_DEMO=false
PORT=8787
