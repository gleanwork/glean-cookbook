{
  "name": "search-with-discovered-filters",
  "version": "0.0.0",
  "private": true,
  "description": "Use the official Glean TypeScript API client to discover filters and run Platform Search.",
  "type": "module",
  "scripts": {
    "login": "glean-auth login --scopes search",
    "start": "tsx src/search.ts",
    "verify": "tsx src/search.ts --auto-select",
    "test": "tsx --test src/*.test.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@gleanwork/api-client": "0.19.0",
    "@gleanwork/auth": "0.5.1",
    "meow": "14.1.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "10.8.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
