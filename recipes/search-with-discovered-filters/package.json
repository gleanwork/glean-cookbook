{
  "name": "search-with-discovered-filters",
  "version": "0.0.0",
  "private": true,
  "description": "Use the official Glean TypeScript API client to discover filters and run Platform Search.",
  "type": "module",
  "scripts": {
    "login": "tsx src/login.ts",
    "start": "tsx src/search.ts",
    "verify": "tsx src/search.ts --auto-select",
    "test": "vitest run",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@gleanwork/api-client": "0.19.0",
    "dotenv": "17.4.2",
    "meow": "14.1.0",
    "open": "11.0.2",
    "openid-client": "6.8.7",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/proper-lockfile": "4.1.4",
    "eslint": "10.8.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  },
  "engines": {
    "node": ">=20"
  }
}
