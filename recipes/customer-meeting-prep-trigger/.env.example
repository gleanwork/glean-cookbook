# Copy this file to .env and set the backend and trigger inputs.
# `npm run login -- --email <work-email>` stores refreshable OAuth
# credentials outside this project.

GLEAN_SERVER_URL=
# Optional user-scoped token fallback. @gleanwork/auth uses it when present.
GLEAN_API_TOKEN=

# The live preset to use. Setup refuses ids that are not in your tenant catalog.
GLEAN_TRIGGER_DATASOURCE=googlecalendar
GLEAN_TRIGGER_PRESET_ID=
GLEAN_TRIGGER_OFFSET_SECONDS=1800
GLEAN_TRIGGER_INPUT_TITLE=Customer QBR

# A public HTTPS URL ending in /webhook. For local testing, use cloudflared
# or another HTTPS tunnel while npm start is running.
GLEAN_WEBHOOK_URL=
GLEAN_WEBHOOK_BEARER_TOKEN=

# npm run setup writes these after the trigger is created.
GLEAN_TRIGGER_ID=
GLEAN_WEBHOOK_SIGNING_SECRET=

# PORT=8787
