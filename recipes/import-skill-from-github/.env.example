# Copy this file to .env only if you are using a user-scoped token instead of OAuth.
# npm run login stores OAuth tokens outside this directory; it does not write .env.
# npm start and npm run verify load .env if present. Existing shell variables win.

# Complete Glean backend HTTPS origin, for example https://acme-be.glean.com
# GLEAN_SERVER_URL=

# User-scoped token with skills:read and skills:write. Do not commit this file.
# GLEAN_API_TOKEN=

# Optional. native (default) or legacy. Overrides .glean-scope-mode from npm run login.
# GLEAN_SKILLS_SCOPE_MODE=
