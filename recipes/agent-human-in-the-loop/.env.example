# Copy the complete backend HTTPS origin from Glean > About > Server instance (QE).
# Do not derive it from the web app URL. Do not add /api or a trailing path.
GLEAN_SERVER_URL=https://your-company-be.glean.com
# ID of your published, chat-triggered agent with confirmation enabled on its tool.
GLEAN_AGENT_ID=replace-with-your-agent-id
# OAuth is preferred: npm run login -- --server-url <backend-origin>
# Optional fallback: a user-scoped API token with agents.run. Leave empty for OAuth.
GLEAN_API_TOKEN=
# Optional fixed local port. Omit to choose an available loopback port.
# PORT=3000
