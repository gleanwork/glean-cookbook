{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "server.ts",
    "src/**/*.ts",
    "lib/**/*.ts",
    "public/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ]
}
