# Copy to .env and fill it in yourself. .env is ignored by git; never commit,
# paste, or print the token.

# Your Glean backend origin, with no path. See
# https://developers.glean.com/get-started/authentication#finding-your-server-url
GLEAN_SERVER_URL=https://your-instance-be.glean.com

# A user-scoped Client API token with the ADMIN_USAGE and PEOPLE scopes, for a
# user with workspace billing permissions.
GLEAN_API_TOKEN=

# Set to true only after confirming you may change this workspace's limits.
GLEAN_ENABLE_WRITES=false
