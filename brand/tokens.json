{
  "$comment": "Reused verbatim from glean-developer-site's src/css/custom.css --gdt-* tokens (design-references/glean-tokens.css, 2026-07 handoff). Do not invent new values here — pull any additional token from the dev site source of truth.",
  "font": {
    "display": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'DM Sans', system-ui, sans-serif",
    "text": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'DM Sans', system-ui, sans-serif"
  },
  "light": {
    "primary": "#343ced",
    "primaryHover": "#131bd4",
    "selectedBg": "#eef0ff",
    "infoFg": "#1d24b8",
    "textPrimary": "#1f2024",
    "textSecondary": "#565a64",
    "bgLight": "#f7f8fa",
    "bgMid": "#eef0f3",
    "borderLight": "#e7e8ed",
    "borderDark": "#c9cbd2",
    "hairline": "#f0f1f4",
    "cardBg": "#ffffff",
    "success": "#22c55e",
    "warningFg": "#92670a",
    "warningBg": "#fff8e5",
    "warningBorder": "#ffe0b3",
    "categories": {
      "search": { "bg": "#d6eeff", "fg": "#1d6fb8" },
      "index": { "bg": "#f0f9d6", "fg": "#6c7d17" },
      "mcp": { "bg": "#fadcff", "fg": "#dd2ca5" },
      "workflow": { "bg": "#ffe9df", "fg": "#ef601b" },
      "agent": { "bg": "#fff2bf", "fg": "#b8860b" },
      "portal": { "bg": "#eef0ff", "fg": "#343ced" }
    }
  },
  "dark": {
    "$comment": "primary, primaryHover, success, and the category tiles are not overridden in dark mode on the dev site — same values as light. Fields marked 'inheritsFrom' resolve through Infima's theme variables there rather than a fixed hex; pick a concrete value per-app if you need one outside Docusaurus.",
    "primary": "#343ced",
    "primaryHover": "#131bd4",
    "selectedBg": "rgba(52, 60, 237, 0.22)",
    "infoFg": "#aab5ff",
    "textPrimary": { "inheritsFrom": "--ifm-font-color-base" },
    "textSecondary": { "inheritsFrom": "--ifm-color-emphasis-600" },
    "bgLight": { "inheritsFrom": "--ifm-background-surface-color" },
    "bgMid": { "inheritsFrom": "--ifm-color-emphasis-200" },
    "borderLight": { "inheritsFrom": "--ifm-color-emphasis-200" },
    "borderDark": { "inheritsFrom": "--ifm-color-emphasis-400" },
    "hairline": { "inheritsFrom": "--ifm-color-emphasis-200" },
    "cardBg": { "inheritsFrom": "--ifm-card-background-color" },
    "success": "#22c55e",
    "warningFg": "#e2b93d",
    "warningBg": "rgba(146, 103, 10, 0.15)",
    "warningBorder": "rgba(146, 103, 10, 0.4)"
  }
}
