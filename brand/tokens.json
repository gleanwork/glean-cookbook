{
  "$comment": "Styling tokens for cookbook demo apps. The primary accent is Glean Blue: recipes demo Glean, so they should look like Glean rather than like a fictional third party. Neutral, text, background, border, feedback and category values are reused verbatim from glean-developer-site's --gdt-* tokens so a demo app and the docs page it's described on read as one product.",
  "font": {
    "display": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'DM Sans', system-ui, sans-serif",
    "text": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', 'DM Sans', system-ui, sans-serif"
  },
  "light": {
    "primary": "#343ced",
    "primaryHover": "#131bd4",
    "selectedBg": "#eceefe",
    "infoFg": "#2229a8",
    "textPrimary": "#1f2024",
    "textSecondary": "#565a64",
    "bgLight": "#f7f8fa",
    "bgMid": "#eef0f3",
    "borderLight": "#e7e8ed",
    "borderDark": "#c9cbd2",
    "hairline": "#f0f1f4",
    "cardBg": "#ffffff",
    "success": "#22c55e",
    "warningFg": "#92670a",
    "warningBg": "#fff8e5",
    "warningBorder": "#ffe0b3",
    "categories": {
      "search": {
        "bg": "#d6eeff",
        "fg": "#1d6fb8"
      },
      "index": {
        "bg": "#f0f9d6",
        "fg": "#6c7d17"
      },
      "mcp": {
        "bg": "#fadcff",
        "fg": "#dd2ca5"
      },
      "workflow": {
        "bg": "#ffe9df",
        "fg": "#ef601b"
      },
      "agent": {
        "bg": "#fff2bf",
        "fg": "#b8860b"
      },
      "portal": {
        "bg": "#e6f5f3",
        "fg": "#0e8c84"
      }
    }
  },
  "dark": {
    "$comment": "primary/primaryHover use the brightened teal tile value so the mark and accents stay legible on near-black. success and the category tiles are unchanged from light. Fields marked 'inheritsFrom' resolve through Infima's theme variables in Docusaurus; pick a concrete value per-app if you need one outside it.",
    "primary": "#6b73ff",
    "primaryHover": "#8f95ff",
    "selectedBg": "rgba(18, 179, 166, 0.22)",
    "infoFg": "#7fe3d8",
    "textPrimary": {
      "inheritsFrom": "--ifm-font-color-base"
    },
    "textSecondary": {
      "inheritsFrom": "--ifm-color-emphasis-600"
    },
    "bgLight": {
      "inheritsFrom": "--ifm-background-surface-color"
    },
    "bgMid": {
      "inheritsFrom": "--ifm-color-emphasis-200"
    },
    "borderLight": {
      "inheritsFrom": "--ifm-color-emphasis-200"
    },
    "borderDark": {
      "inheritsFrom": "--ifm-color-emphasis-400"
    },
    "hairline": {
      "inheritsFrom": "--ifm-color-emphasis-200"
    },
    "cardBg": {
      "inheritsFrom": "--ifm-card-background-color"
    },
    "success": "#22c55e",
    "warningFg": "#e2b93d",
    "warningBg": "rgba(146, 103, 10, 0.15)",
    "warningBorder": "rgba(146, 103, 10, 0.4)"
  }
}
